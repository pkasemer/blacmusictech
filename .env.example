# Copy to .env.local for local development.

# Where the Blac Music API lives. The site's server calls it; the browser never does.
# Local docker stack: http://localhost:8080. Mock backend (npm run mock): http://localhost:8090.
BACKEND_URL=http://localhost:8080

# Secret that encrypts the session cookie. 32+ random characters, REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The public origin of this site (used for the Origin/CSRF check). Dev default: http://localhost:3100
SITE_ORIGIN=http://localhost:3100

# Set to true only when a trusted reverse proxy (nginx) sits in front and appends X-Forwarded-For.
TRUST_PROXY=false

# Session lifetime in minutes.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720

# Dev stopgap while the Backend has no POST /v1/admin/auth/login: sign in with /v1/auth/login and
# check role=admin through /v1/me. Ignored in production.
ADMIN_LOGIN_FALLBACK=false
