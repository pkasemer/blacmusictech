# Copy to /opt/blacmusic/admin/.env on the server (deploy/ship.sh creates it with a fresh secret).
# Never commit the real file.

TAG=latest

# Encrypts the session cookie. 32+ random characters, generated once:  openssl rand -base64 48
# Changing it signs every administrator out.
SESSION_SECRET=change-me

# The public address of the admin site (https only). Cookies, CSRF and the CSP depend on it.
SITE_ORIGIN=https://blacadmin.pkasemer.com

# Where artist and cover images are served from (added to the page's img-src).
IMAGE_ORIGINS=https://blacmusic.pkasemer.com

# Where the admin player loads audio from (the object storage host the API signs links for).
MEDIA_ORIGINS=https://blacmedia.pkasemer.com

# Session lifetime in minutes: idle timeout (sliding) and absolute maximum.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
